---
// 블로그 목록 페이지 — 모든 글을 시간순으로 표시합니다.
// 태그 필터링은 /tags 페이지에서 별도로 제공합니다.

import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getCollection } from 'astro:content';

// 모든 글 가져오기 (초안 제외, 발행일 기준 정렬)
const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="블로그 | Muita Blog" description="전체 블로그 글 목록">
  <h1 class="page-title">블로그</h1>
  <div class="posts-list">
    {posts.map((post) => (
      <BlogCard
        title={post.data.title}
        description={post.data.description}
        pubDate={post.data.pubDate}
        tags={post.data.tags}
        slug={post.slug}
      />
    ))}
  </div>

  {/* 태그 필터 링크 */}
  <div class="tag-filter-link">
    <a href="/tags">태그로 찾기 &rarr;</a>
  </div>
</BaseLayout>

<style>
  .tag-filter-link {
    margin-top: var(--spacing-2xl);
    padding-top: var(--spacing-lg);
    border-top: 1px solid var(--color-border);
  }

  .tag-filter-link a {
    font-size: 0.95rem;
    font-weight: 500;
  }
</style>
